# tabs for autocomplete
hook global InsertCompletionShow .* %{
  try %{
    # this command temporarily removes cursors preceded by whitespace;
    # if there are no cursors left, it raises an error, does not
    # continue to execute the mapping commands, and the error is eaten
    # by the `try` command so no warning appears.
    execute-keys -draft 'h<a-K>\h<ret>'
    map window insert <tab> <c-n>
    map window insert <s-tab> <c-p>
    hook -once -always window InsertCompletionHide .* %{
      unmap window insert <tab> <c-n>
      unmap window insert <s-tab> <c-p>
    }
  }
}


# swap q and b
map global normal <q> "b"
map global normal <Q> "B"
map global normal <a-q> "<a-b>"
map global normal <a-Q> "<a-B>"
map global normal <b> "q"
map global normal <B> "Q"
map global normal <a-b> "<a-q>"
map global normal <a-B> "<a-Q>"

map global user k '' -docstring 'show docs for item under cursor'
map global normal <esc> ";,"
map global normal <c-v> ":comment-line<ret>"

## map -docstring "enter-user-mode" global normal <space> ":enter-user-mode<space>user<ret>"
map -docstring "buffer next" global user g ":bn<ret>"
map -docstring "buffer previous" global user G ":bp<ret>"

# Clipboard management mappings
map -docstring "yank to system clipboard" global user y "<a-|>wl-copy<ret>"
map -docstring "paste from system clipboard" global user p "<a-!>wl-paste<ret>"
map -docstring "save current buffer" global user s ":write<ret>"


#
# Helix Leader-mode
map global user f ':fzf-mode<ret>f'           -docstring 'open file picker'
map global user F ':fzf-mode<ret>F'           -docstring 'open file picker at cwd (fzf uses cwd by default)'

# e/E - file explorer: requires a plugin like lf.kak, ranger.kak, or similar
# No direct fzf equivalent for "explorer". Leave unmapped or bind to a file manager.
# map global user e ...  # open file explorer at workspace root  — NO EQUIVALENT
# map global user E ...  # open file explorer at buffer's directory — NO EQUIVALENT

map global user b ':fzf-mode<ret>b'           -docstring 'open buffer picker'

# j - jumplist picker: Kakoune has jump-forward/back but no interactive jumplist picker
# map global user j ...  # open jumplist picker — NO EQUIVALENT (no interactive jumplist in kak or fzf.kak)

map global user s ':lsp-goto-document-symbol<ret>' -docstring 'open symbol picker (LSP document symbols)'
#map global user S ':lsp-workspace-symbol ""<ret>' -docstring 'open workspace symbol picker (LSP)'

map global user d ':lsp-diagnostics<ret>'     -docstring 'open diagnostic picker (buffer)'
map global user D ':lsp-diagnostics<ret>'     -docstring 'open workspace diagnostics — kak-lsp shows all, no separate workspace view'

map global user g ':fzf-mode<ret>v'           -docstring 'changed file picker (fzf-vcs)'

map global user a ':lsp-code-actions<ret>'    -docstring 'perform code action'
map global user / ':fzf-mode<ret>g'           -docstring 'global search in workspace (fzf grep)'

# G - debug: no DAP in stock kak-lsp; skip unless you have kak-dap
# map global user G ...  # debug (experimental) — NO EQUIVALENT without kak-dap

# w - window management: Kakoune uses its own client/window model; no submenu equivalent
# map global user w ...  # window submenu — NO DIRECT EQUIVALENT (use tmux/splits directly)

map global user R '|xclip -selection clipboard -o<ret>'   -docstring 'replace selections with clipboard'

map global user l ':fzf-mode<ret>/'           -docstring 'local search in buffer (fzf buffer lines)'

# L - fuzzy local search in buffer: fzf-mode `/` already does this
map global user L ':fzf-mode<ret>/'           -docstring 'fuzzy local search in buffer'

map global user k ':lsp-hover<ret>'           -docstring 'show docs for item under cursor'
map global user r ':lsp-rename-prompt<ret>'   -docstring 'rename symbol'
map global user h ':lsp-highlight-references<ret>' -docstring 'select/highlight symbol references'

map global user c ':comment-line<ret>'        -docstring 'comment/uncomment selections (line)'
map global user C ':comment-block<ret>'       -docstring 'block comment/uncomment selections'

# A-c - line comment toggle: same as `c` above; bind the chord in user mode
map global user <C-c> ':comment-line<ret>'    -docstring 'line comment/uncomment selections'

# B - git blame: requires kak-git or similar
map global user B ':git blame<ret>'           -docstring 'show blame for current line (requires git.kak)'



#
# Kak LSP
# Docs: https://github.com/kakoune-lsp/kak-lsp
# 
map global user   -docstring 'LSP mode' l %{:enter-user-mode lsp<ret>}

map global insert -docstring 'Select next snippet placeholder' <tab> '<a-;>:try lsp-snippets-select-next-placeholders catch %{ execute-keys -with-hooks <lt>tab> }<ret>'
map global object -docstring 'LSP any symbol' a '<a-semicolon>lsp-object<ret>'
map global object -docstring 'LSP any symbol' <a-a> '<a-semicolon>lsp-object<ret>'
map global object -docstring 'LSP function or method' f '<a-semicolon>lsp-object Function Method<ret>'
map global object -docstring 'LSP class interface or struct' t '<a-semicolon>lsp-object Class Interface Struct<ret>'
map global object -docstring 'LSP errors and warnings' d '<a-semicolon>lsp-diagnostic-object --include-warnings<ret>'
map global object -docstring 'LSP errors' D '<a-semicolon>lsp-diagnostic-object<ret>'


