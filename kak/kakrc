# https://frog.ski/blog/writing-your-first-kakrc

eval %sh{ kak-tree-sitter -dks --init $kak_session -vvv }
eval %sh{ kak-lsp --kakoune -s $kak_session}
lsp-enable
enable-auto-pairs

colorscheme rose_pine

set-option global tabstop 2
set-option global indentwidth 2
set-option global scrolloff 1,3
set-option global ui_options ncurses_status_on_top=false
set-option global ui_options terminal_assistant=none
set-option global auto_pairs ( ) { } [ ] '"' '"' "'" "'" ` ` “ ” ‘ ’ « » ‹ ›

# Highlight trailing whitespace
add-highlighter global/ regex \h+$ 0:Error
add-highlighter global/ wrap -word -indent
add-highlighter global/ show-matching
add-highlighter global/ number-lines -hlcursor -relative -separator "  " -min-digits 3
add-highlighter global/ show-whitespaces

# close kak-lsp on exit?
hook global KakEnd .* lsp-exit

# exit edit mode with `jk`
hook global InsertChar k %{ try %{
  exec -draft hH <a-k>jk<ret> d
  exec -with-hooks <esc>
}}

# Change color in insert mode
hook global ModeChange ".*:normal" %{
    face window PrimaryCursor black,white+F
    face window PrimaryCursorEol black,blue+F
    face window SecondaryCursor black,bright-green+F
    face window SecondarySelection black,green+F
}
## set cursor to default
hook global ModeChange ".*:insert" %{
    face window PrimaryCursor black,red+F
    face window PrimaryCursorEol black,red+F
    face window SecondaryCursor black,red+F
    face window SecondarySelection black,green+F
}

# tabs for autocomplete
hook global InsertCompletionShow .* %{
  try %{
    execute-keys -draft 'h<a-K>\h<ret>'
    map window insert <tab> <c-n>
    map window insert <s-tab> <c-p>
    hook -once -always window InsertCompletionHide .* %{
      unmap window insert <tab> <c-n>
      unmap window insert <s-tab> <c-p>
    }
  }
}

# ------------------------------------ Stray Commands

# source "%val{config}/bundle/fzf.kak/rc/modules/fzf-cd.kak"
# source "%val{config}/bundle/fzf.kak/rc/modules/fzf-recent.kak"
# source "%val{config}/bundle/fzf.kak/rc/modules/fzf-search.kak"

define-command -hidden picker-split-location %{
  set-register l %sh{ printf '%s' "${kak_opt_picker_item%%:*}" } %sh{
    r=${kak_opt_picker_item#*:}; r=${r%%:*}
    case $r in ''|*[!0-9]*) r=1 ;; esac
    printf '%s' "$r"
  }
}

define-command loc-jump -docstring 'open a path:line item in jumpclient if there is one, else here' %{
  evaluate-commands -save-regs l %{
    picker-split-location
    evaluate-commands -try-client %opt{jumpclient} -verbatim -- edit -existing -- %reg{l}
    try %{ focus %opt{jumpclient} }
  }
}

define-command loc-preview -docstring 'preview a path:line item' %{
  evaluate-commands -save-regs l %{
    picker-split-location
    evaluate-commands -verbatim -- edit -existing -- %reg{l}
  }
}

set-option global grepcmd 'rg --line-number --no-heading --column --smart-case'
define-command pick-grep %{
  picker-filter -script "%opt{grepcmd} '.'" \
    -on-select loc-jump -on-change loc-preview
}
define-command pick-refs %{
  lsp-references
  picker-filter -buffer "*goto*" -on-select loc-jump
}
define-command pick-files %{ picker-filter -script 'fd -t f' }
define-command pick-current %{ picker-filter -buffer %val{bufname} }

define-command -hidden pick-buffer-with -params 1 %{
  picker-filter -script %sh{
    out="printf '%s\\n'"
    eval "set -- $kak_quoted_buflist"
    for b; do
      out="$out $(printf "'%s'" "$(printf '%s' "$b" | sed "s/'/'\\\\''/g")")"
    done
    printf '%s' "$out"
  } -on-select %arg{1} -on-change 'buffer %opt{picker_item}'
}

define-command pick-buffers -docstring 'pick a buffer to switch to' %{
  pick-buffer-with 'buffer %opt{picker_item}'
}

define-command pick-buffer-delete -docstring 'pick a buffer to delete' %{
  pick-buffer-with 'delete-buffer %opt{picker_item}'
}

define-command ide -params 0..1 -docstring 'ide [session-name]: Turn Kakoune into an IDE' %{
  # Session name
  try %{
    rename-session %arg{1}
  }

  # Main client
  rename-client main
  set-option global jumpclient main

  # Tools client
  new %{
    rename-client tools
    set-option global toolsclient tools
  }
}

define-command sh-exec -override -params 0 %{
  evaluate-commands -draft -save-regs '|"' %sh{
    if [[ "${#kak_selection}" -eq 1 ]]
		then
			# we don't have any selected text, select anything after `$ ` and execute it, outputting it
			# below the line
	 		printf '%s\n' \
	 		"
			try %{
				execute-keys x 1s \\$<space>(.+)\n<ret>
				set-register '|' %val{selection}
				execute-keys o <esc> !<ret>
				execute-keys j d
			}
			"
		else
			printf '%s\n' \
			"
			set-register '|' %val{selection}
			execute-keys o <esc> !<ret>
			execute-keys j d
			"
		fi
  }
}


