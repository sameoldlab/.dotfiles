#-------------------- Lang scraps

hook -group lsp-language-id global BufSetOption filetype=solidity %{
  set-option buffer lsp_servers %{
    [nomicfoundation-solidity-language-server]
    args = ["--stdio"]
    root_globs = ["Foundry.toml", ".sol", ",git"]
  }
  set-option buffer lsp_language_id nomicfoundation-solidity-language-server
}

hook -group lsp-language-id global BufSetOption filetype=sh %{
    set-option buffer lsp_language_id shellscript
}

remove-hooks global lsp-filetype-python
hook -group lsp-filetype-python global BufSetOption filetype=python %{
    set-option buffer lsp_servers %{
        [basedpyright]
        command = "basedpyright-langserver"
        root_globs = ["pyproject.toml", "setup.py", "poetry.lock", ".git", ".hg"]
        args = ["--stdio"]
        [ty]
        command = "ty"
        args = ["server"]
        root_globs = ["pyproject.toml", "setup.py", "poetry.lock", ".git", ".hg"]
        [ruff]
        args = ["server", "--quiet"]
        root_globs = ["pyproject.toml", "setup.py", "poetry.lock", ".git", ".hg"]
        settings_section = "_"
        [ruff.settings._.globalSettings]
        organizeImports = true
        fixAll = true
    }
}

hook global WinSetOption filetype=odin %{
    set-option buffer formatcmd "odinfmt %val{buffile}"
    set-option buffer makecmd "odin build ."
}
