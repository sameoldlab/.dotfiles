# https://frog.ski/blog/writing-your-first-kakrc
# Plugins
source "%val{config}/bundle/kak-ansi/rc/ansi.kak"
evaluate-commands %sh{ kak-tree-sitter -dks --init "$kak_session" -vvv }
# enable LSP
eval %sh{ kak-lsp --kakoune -s $kak_session}
lsp-enable

hook global KakEnd .* lsp-exit


map global user t ':enter-user-mode tree-sitter<ret>' -docstring 'tree-sitter'

colorscheme carbonfox 
colorscheme rose_pine

set-option global tabstop 2
set-option global indentwidth 2
set-option global scrolloff 1,3
set-option global ui_options ncurses_status_on_top=true
set-option global ui_options terminal_assistant=none

source "%val{config}/bundle/fzf.kak/rc/fzf.kak"
source "%val{config}/bundle/fzf.kak/rc/modules/fzf-buffer.kak"
source "%val{config}/bundle/fzf.kak/rc/modules/fzf-file.kak"
source "%val{config}/bundle/fzf.kak/rc/modules/fzf-search.kak"
evaluate-commands %sh{kak-popup init }

# Highlight trailing whitespace
# add-highlighter global/ regex \h+$ 0:Error
add-highlighter global/ wrap -word -indent
add-highlighter global/ show-matching
add-highlighter global/ number-lines -hlcursor -relative -separator "  " -min-digits 3

# exit edit mode with `jk`
hook global InsertChar k %{ try %{
  exec -draft hH <a-k>jk<ret> d
  exec -with-hooks <esc>
}}

define-command acme-exec %{
  set-option local windowing_placement horizontal
  terminal sh -c %val{selection}
}

map global normal <C-s> ':write<ret>'
map global normal <C-g> ':acme-exec<ret>'
map global normal <ret> '<A-o>'
map global normal <S-ret> '<A-O>'
map global normal <A-o> '<A-o>'
# map global normal <ret> '<A-O>'

