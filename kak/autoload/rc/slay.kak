# slay.kak — Kakoune client for the slay Lisp server

declare-option -docstring 'host:port of the slay server' str slay_host 'localhost:3701'
declare-option -docstring 'range-specs used to flag the result of the last compile/eval' range-specs slay_flags
declare-option -docstring 'completions generated by slay' -hidden completions slay_completions

define-command -override -docstring 'Enable slay for the window' \
slay-enable-window %<
    require-module slay

    add-highlighter window/slay_flags replace-ranges slay_flags
    set-option window completers "option=slay_completions" %opt<completers>

    hook -group slay window InsertIdle .* %{
        slay-complete
    }
>

define-command -override -docstring 'Disable slay for the window' \
slay-disable-window %<
    remove-highlighter window/slay_flags
    set-option -remove window completers "option=slay_completions"
    remove-hooks window slay
>

# ---------------------------------------------------------------------
# Plumbing

declare-option -hidden str slay_current_package 'COMMON-LISP-USER'

define-command -override -docstring 'Selects a Lisp top-level form around the cursor' -hidden \
slay-select-form %<
    try %<
      execute-keys '<a-a>b'
      slay-select-form
    >
>

define-command -override -docstring 'Detects the current Lisp package' -hidden \
slay-detect-package %<
    evaluate-commands -draft -save-regs 'p' %<
        set-register p %opt<slay_current_package>
        try %<
            execute-keys -draft '<esc><a-/>^\(in-package<ret>t)b"py'
        >
        set-option buffer slay_current_package %reg<p>
    >
>

provide-module slay %<

# ---------------------------------------------------------------------
# Completion

# this is SLOW!!!. Replace with async ASAP.
define-command -docstring 'Generates completion candidates at the cursor' -hidden \
slay-complete %{
    evaluate-commands -draft -save-regs 'wa' %{
      try %{
        execute-keys 'h<a-i>w<a-semicolon>"wy'
        evaluate-commands %{

        set-option window slay_completions "%val{cursor_line}.%val{cursor_column}+%val{selection_length}@%val{timestamp}"
        slay-detect-package

        evaluate-commands %sh{
            printf '(:complete "%s" "%s")' "$kak_opt_slay_current_package" "$kak_reg_w" \
            | socat - "tcp:$kak_opt_slay_host" \
            | while IFS="$(printf '\t')" read -r name kind lambda_list
              do
                  [ -z "$name" ] && continue
                  esc_name=$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/|/\\|/g' | tr '[:upper:]' '[:lower:]')
                  menu="$esc_name              $kind"
                  esc_menu=$(printf '%s' "$menu" | sed 's/\\/\\\\/g; s/|/\\|/g')
                  printf 'set-option -add window slay_completions "%s||%s"\n' "$esc_name" "$esc_menu"
              done
        }}
        } catch %{
          set-option window slay_completions
        }
    }
}


# ---------------------------------------------------------------------
# Compile / reload in REPL

define-command -docstring 'Flags the result of a compile/eval at the given anchor' -hidden -params 3 \
slay--flag-result %<
    # params: anchor-coord status summary
    evaluate-commands %sh<
        anchor="$1"; status="$2"; summary="$3"
        case "$status" in
            ok) face="String" ;;
            warnings) face="Attribute" ;;
            *) face="Error" ;;
        esac
        clipped=$(printf '%s' "$summary" | cut -c1-120)
        spec_escaped=$(printf '%s' "$clipped" | sed 's/\\/\\\\/g; s/|/\\|/g; s/{/\\{/g')
        dquote_escaped=$(printf '%s' "$spec_escaped" | sed 's/%/%%/g; s/"/""/g')
        printf 'set-option window slay_flags %%val{timestamp} "%s+0|{%s}%s"\n' \
            "$anchor" "$face" "$dquote_escaped"
    >
>

define-command -docstring 'Compiles the Lisp form under the cursor (reload in REPL)' \
slay-compile-form %<
    evaluate-commands -save-regs 's' %<
        slay-select-form
        set-register s %val<selection>
        slay-detect-package
        evaluate-commands %sh<
            src=$(printf '%s' "$kak_reg_s" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' ')
            pkg=$(printf '%s' "$kak_opt_slay_current_package" | sed 's/\\/\\\\/g; s/"/\\"/g')
            file=$(printf '%s' "$kak_buffile" | sed 's/\\/\\\\/g; s/"/\\"/g')

            result=$(printf '(:compile "%s" "%s" %s "%s")' "$pkg" "$file" "$kak_cursor_byte_offset" "$src" \
                | socat - "tcp:$kak_opt_slay_host")
            status=$(printf '%s' "$result" | cut -f1)
            summary=$(printf '%s' "$result" | cut -f2)
            escaped_summary=$(printf '%s' "$summary" | sed 's/\\/\\\\/g; s/"/\\"/g')
            printf 'slay--flag-result "%%val{cursor_line}.%%val{cursor_column}" %s "%s"\n' \
                "$status" "$escaped_summary"
        >
    >
    trigger-user-hook slay_compiled
>

define-command -docstring 'Compiles the whole buffer (reload in REPL)' \
slay-compile-buffer %<
    evaluate-commands -save-regs 'b' %<
        execute-keys '%"by'
        slay-detect-package
        evaluate-commands %sh<
            src=$(printf '%s' "$kak_reg_b" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' ')
            pkg=$(printf '%s' "$kak_opt_slay_current_package" | sed 's/\\/\\\\/g; s/"/\\"/g')
            file=$(printf '%s' "$kak_buffile" | sed 's/\\/\\\\/g; s/"/\\"/g')
            result=$(printf '(:compile "%s" "%s" 0 "%s")' "$pkg" "$file" "$src" \
                | socat - "tcp:$kak_opt_slay_host")
            status=$(printf '%s' "$result" | cut -f1)
            summary=$(printf '%s' "$result" | cut -f2)
            case "$status" in
                ok) printf "info 'slay: buffer compiled cleanly'\n" ;;
                warnings) printf "info -markup 'slay: {Error}compiled with warnings'\n" ;;
                *) printf "info -markup 'slay: {Error}compile error'\n" ;;
            esac
            escaped_summary=$(printf '%s' "$summary" | sed "s/'/''/g")
            printf "echo -debug 'slay compile: %s'\n" "$escaped_summary"
        >
    >
    trigger-user-hook slay_compiled
>

define-command -docstring 'Evaluates the form under the cursor, shows the value inline' \
slay-eval-form %<
    evaluate-commands -save-regs 's' %<
        slay-select-form
        # %sh{ printf 'echo -debug "%s"' $kak_selection }
        set-register s %val<selection>
        slay-detect-package
        evaluate-commands %sh<
            src=$(printf '%s' "$kak_reg_s" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' ')
            pkg=$(printf '%s' "$kak_opt_slay_current_package" | sed 's/\\/\\\\/g; s/"/\\"/g')
            # Same flat status<TAB>summary line as :compile
            # write-status-response in package.lisp.
            result=$(printf '(:eval "%s" "%s")' "$pkg" "$src" \
                | socat - "tcp:$kak_opt_slay_host")
            status=$(printf '%s' "$result" | cut -f1)
            summary=$(printf '%s' "$result" | cut -f2)
            escaped_summary=$(printf '%s' "$summary" | sed 's/\\/\\\\/g; s/"/\\"/g')
            printf 'slay--flag-result "%%val{cursor_line}.%%val{cursor_column}" %s "%s"\n' \
                "$status" "$escaped_summary"
        >
    >
>

define-command -docstring 'Shows documentation for the symbol under the cursor' \
slay-doc-cursor %<
    evaluate-commands -save-regs 'w' %<
        execute-keys -draft '<a-i>w"wy'
        slay-detect-package
        info %sh<
            # (status<TAB>kind<TAB>lambda-list)
            # doc text completely verbatim with no escaping at all
            printf '(:describe "%s" "%s")' "$kak_opt_slay_current_package" "$kak_reg_w" \
                | socat - "tcp:$kak_opt_slay_host" \
                | tail -n +3
        >
    >
>

# ---------------------------------------------------------------------
# Goto definition

define-command -docstring 'Goes to the definition of the symbol under the cursor' \
slay-goto-definition-cursor %<
    evaluate-commands -save-regs 'w' %<
        execute-keys -draft '<a-i>w'
        set-register w %val<selection>
        slay-detect-package
        evaluate-commands %sh<
            sym=$(printf '%s' "$kak_reg_w" | sed 's/\\/\\\\/g; s/"/\\"/g')
            pkg=$(printf '%s' "$kak_opt_slay_current_package" | sed 's/\\/\\\\/g; s/"/\\"/g')
            response=$(printf '(:location "%s" "%s" :function)' "$pkg" "$sym" \
                | socat - "tcp:$kak_opt_slay_host")
            status=$(printf '%s' "$response" | grep -o ':STATUS :[A-Z-]*' | cut -d' ' -f2)
            sym_sq=$(printf '%s' "$kak_reg_w" | sed "s/'/''/g")
            if [ "$status" != ":OK" ]
            then
                printf "info 'slay: no definition found for %s'\n" "$sym_sq"
                exit 0
            fi
            path=$(printf '%s' "$response" | sed -n 's/.*:PATHNAME "\([^"]*\)".*/\1/p')
            offset=$(printf '%s' "$response" | grep -o ':OFFSET [0-9]*' | cut -d' ' -f2)
            if [ -z "$path" ] || [ -z "$offset" ]
            then
                printf "info 'slay: no source location for %s'\n" "$sym_sq"
                exit 0
            fi

            path_sq=$(printf '%s' "$path" | sed "s/'/''/g")
            printf "edit '%s'\n" "$path_sq"
            printf 'execute-keys gg%sl\n' "$offset"
        >
    >
>

# ---------------------------------------------------------------------
# Keymap

# map -docstring 'Compile form under cursor (reload in REPL)' global normal <a-e> ': enter-user-mode slay<ret>'
map -docstring 'show docs for symbol under cursor' global user k ': slay-doc-cursor<ret>'
map -docstring 'goto definition' global goto d ': slay-goto-definition<ret>'

declare-user-mode slay
map -docstring 'Compile form under cursor (reload in REPL)' global slay c ': slay-compile-form<ret>'
map -docstring 'Compile whole buffer (reload in REPL)' global slay b ': slay-compile-buffer<ret>'
map -docstring 'Eval form under cursor' global slay e ': slay-eval-form<ret>'
map -docstring 'Show docs for symbol under cursor' global slay h ': slay-doc-cursor<ret>'
map -docstring 'Goto definition of symbol under cursor' global slay d ': slay-goto-definition-cursor<ret>'

>

