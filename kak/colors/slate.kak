declare-option str n98   "rgb:fafafa"
declare-option str n86   "rgb:dcdcdc"
declare-option str n79   "rgb:c9c9c9"
declare-option str n68   "rgb:adadad"
declare-option str n63   "rgb:a1a1a1"
declare-option str n49   "rgb:7D7D7D"
declare-option str n04   "rgb:111111"

declare-option str yellow  "rgb:d7cfaf"
declare-option str yellow  "%opt{n98}"

declare-option str magenta   "%opt{n98}"
declare-option str n86      "%opt{n86}"
declare-option str text      "%opt{n79}"
declare-option str wasred    "%opt{n68}"
declare-option str cyan      "%opt{n68}"
declare-option str wasgreen  "%opt{n63}"
declare-option str overlay   "rgb:6e6a86"
declare-option str subtext   "%opt{n49}"
declare-option str surface   "rgb:444444"
declare-option str base      "rgb:333333"
declare-option str mantle    "rgb:222222"
declare-option str crust     "%opt{n04}"

# Markup
set-face global title  "%opt{text}+b"
set-face global header "%opt{text}+b"
set-face global bold   "%opt{text}+b"
set-face global italic "%opt{text}+i"
set-face global mono   "%opt{text}"
set-face global block  "%opt{text}"
set-face global link   "%opt{text}+u"
set-face global bullet "%opt{text}"
set-face global list   "%opt{text}"

# Builtins
set-face global Default            "%opt{text},%opt{crust}"
set-face global PrimarySelection   "default,rgba:99999955"
set-face global SecondarySelection "default,rgba:99999933"
set-face global PrimaryCursor      "%opt{base},%opt{text}+b"
set-face global SecondaryCursor    "%opt{surface},%opt{text}+b"
set-face global PrimaryCursorEol   "%opt{surface},%opt{n86}"
set-face global SecondaryCursorEol "%opt{surface},%opt{overlay}"
set-face global LineNumbers        "%opt{overlay},default"
set-face global LineNumberCursor   "%opt{subtext},default+b"
set-face global LineNumbersWrapped "red,default"
set-face global MenuForeground     "default,%opt{mantle}+i"
set-face global MenuBackground     "%opt{subtext},%opt{crust}"
set-face global MenuInfo           "%opt{subtext},%opt{crust}"
set-face global Information        "%opt{subtext},%opt{crust}"
set-face global Error              "%opt{crust},red"
set-face global DiagnosticError    "default,default,red+c"
set-face global DiagnosticWarning  "default,default,%opt{yellow}+c"
set-face global StatusLine         "%opt{subtext},default"
set-face global StatusLineMode     "%opt{crust},%opt{wasgreen}"
set-face global StatusLineInfo     "%opt{magenta},%opt{base}"
set-face global StatusLineValue    "%opt{crust},%opt{yellow}"
set-face global StatusCursor       "default,%opt{overlay}"
set-face global Prompt             "default,default"
set-face global MatchingChar       "%opt{magenta},%opt{mantle}+b"
set-face global Whitespace         "%opt{mantle},default"
set-face global WrapMarker         "%opt{overlay},default+f"
set-face global BufferPadding      "%opt{base},default"

# Change color in insert mode
hook global ModeChange ".*:normal" %{
    face window PrimaryCursor      "%opt{base},%opt{text}+bF"
    face window SecondaryCursor    "%opt{base},%opt{text}+bF"
    face window PrimaryCursorEol   "%opt{base},%opt{text}+bF"
    face window SecondarySelection "%opt{base},%opt{n86}+F"
}
# set cursor to default
hook global ModeChange ".*:insert" %{
    face window PrimaryCursor      black,red+F
    face window PrimaryCursorEol   "black,%opt{n86}+F"
    face window SecondaryCursor    black,red+F
    face window SecondarySelection "black,%opt{n86}+F"
}

# Code
set-face global value         "%opt{yellow}"
set-face global type          "%opt{n86}"
set-face global variable      "%opt{text}+b"
set-face global module        "%opt{n49}"
set-face global function      "%opt{n79}+b"
set-face global string        "%opt{n63}"
set-face global keyword       "%opt{subtext}"
set-face global operator      "%opt{n86}"
set-face global attribute     "%opt{yellow}"
set-face global comment       "%opt{subtext}+i"
set-face global documentation "%opt{subtext}+i"
set-face global meta          "%opt{subtext}"
set-face global builtin       "%opt{n86}"

set-face global ts_attribute                    "%opt{yellow}"
set-face global ts_comment                      "%opt{subtext}+i"
set-face global ts_comment_unused               "%opt{subtext}+isd"
set-face global ts_conceal                      "%opt{wasred}+i"
set-face global ts_constant                     "%opt{cyan}"
set-face global ts_constant_builtin_boolean     "%opt{n86}"
set-face global ts_constant_character           "%opt{yellow}"
set-face global ts_constant_macro               "%opt{wasred}"
set-face global ts_constructor                  "%opt{n86}"
set-face global ts_diff_plus                    "green"
set-face global ts_diff_minus                   "red"
set-face global ts_diff_delta                   "%opt{n86}"
set-face global ts_diff_delta_moved             "red"
set-face global ts_error                        "red+b"
set-face global ts_function                     "function"
set-face global ts_function_builtin             "function"
set-face global ts_function_macro               "%opt{wasgreen}"
set-face global ts_hint                         "%opt{n86}+b"
set-face global ts_info                         "%opt{n86}+b"
set-face global ts_keyword                      "keyword"
set-face global ts_keyword_conditional          "keyword"
set-face global ts_keyword_control_conditional  "keyword"
set-face global ts_keyword_control_directive    "keyword"
set-face global ts_keyword_control_import       "keyword"
set-face global ts_keyword_directive            "keyword"
set-face global ts_keyword_storage              "keyword"
set-face global ts_keyword_storage_modifier     "keyword"
set-face global ts_keyword_storage_modifier_mut "keyword"
set-face global ts_keyword_storage_modifier_ref "keyword"
set-face global ts_label                        "%opt{n86}+i"
set-face global ts_markup_bold                  "%opt{cyan}+b"
set-face global ts_markup_heading               "%opt{text}+b"
set-face global ts_markup_heading_1             "%opt{text}+b"
set-face global ts_markup_heading_2             "%opt{text}+b"
set-face global ts_markup_heading_3             "%opt{text}+b"
set-face global ts_markup_heading_4             "%opt{text}+b"
set-face global ts_markup_heading_5             "%opt{text}+b"
set-face global ts_markup_heading_6             "%opt{text}+b"
set-face global ts_markup_heading_marker        "%opt{cyan}+b"
set-face global ts_markup_italic                "%opt{wasred}+i"
set-face global ts_markup_list_checked          "%opt{wasgreen}"
set-face global ts_markup_list_numbered         "%opt{n86}+i"
set-face global ts_markup_list_unchecked        "%opt{wasgreen}"
set-face global ts_markup_list_unnumbered       "%opt{wasred}"
set-face global ts_markup_link_label            "%opt{n86}"
set-face global ts_markup_link_url              "%opt{wasgreen}+u"
set-face global ts_markup_link_uri              "%opt{wasgreen}+u"
set-face global ts_markup_link_text             "%opt{n86}"
set-face global ts_markup_quote                 "%opt{overlay}"
set-face global ts_markup_raw                   "%opt{wasgreen}"
set-face global ts_markup_strikethrough         "%opt{overlay}+s"
set-face global ts_namespace                    "%opt{n86}+i"
set-face global ts_operator                     "%opt{n86}"
set-face global ts_property                     "%opt{n86}"
set-face global ts_punctuation                  "%opt{overlay}"
set-face global ts_punctuation_special          "%opt{n86}"
set-face global ts_special                      "%opt{n86}"
set-face global ts_spell                        "red"
set-face global ts_string                       string
set-face global ts_string_regex                 "%opt{cyan}"
set-face global ts_string_regexp                "%opt{cyan}"
set-face global ts_string_escape                "%opt{wasred}"
set-face global ts_string_special               "%opt{n86}"
set-face global ts_string_special_path          "%opt{wasgreen}"
set-face global ts_string_special_symbol        "%opt{wasred}"
set-face global ts_string_symbol                "%opt{wasred}"
set-face global ts_tag                          "red"
set-face global ts_tag_error                    "red"
set-face global ts_text                         "%opt{n63}"
set-face global ts_text_title                   "%opt{wasred}"
set-face global ts_type                         "%opt{wasgreen}"
set-face global ts_type_enum_variant            "%opt{n86}"
set-face global ts_type_enum_variant_builtin    "%opt{n86}+i"
set-face global ts_variable                     "%opt{text}"
set-face global ts_variable_builtin             "%opt{text}"
set-face global ts_variable_other_member        "%opt{text}+i"
set-face global ts_variable_parameter           "%opt{text}"
set-face global ts_warning                      "%opt{text}+i"
