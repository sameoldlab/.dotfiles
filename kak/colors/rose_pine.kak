# code

face global value rgb:ebbdbc,default
face global type rgb:c4a7e7,default
face global identifier rgb:317590,rgb:201d2f
face global string rgb:f6c279,default
face global error default,rgb:ffffff
face global keyword rgb:9dcfd8,default+i
face global operator rgb:dedede,default
face global attribute rgb:ffffff,default
face global comment rgb:6e6986,default
face global meta rgb:878787,default

# text

face global title rgb:ffffff,default+b
face global header rgb:ffffff,default
face global bold rgb:ffffff,default+b
face global italic rgb:ededed,default+i
face global mono rgb:cccccc,rgb:212121
face global block rgb:cccccc,rgb:212121
face global link rgb:ffffff,default
face global bullet rgb:ffffff,default
face global list rgb:dedede,default

# kakoune UI

face global Default rgb:dedede,rgb:1a1825
face global PrimarySelection rgb:ffffff,rgb:403d52
face global SecondarySelection rgb:cccccc,rgb:252239
face global PrimaryCursor rgb:000000,rgb:ffffff+b
face global SecondaryCursor rgb:121212,rgb:dedede+b
face global MatchingChar default,rgb:333333
face global Search default,rgb:333333
face global Whitespace default,rgb:333333
face global BufferPadding rgb:deddf4,rgb:1a1825
face global LineNumbers rgb:333333,default
face global LineNumberCursor rgb:666666,default
face global MenuForeground rgb:ffffff,rgb:252239
face global MenuBackground rgb:deddf4,rgb:201d2f
face global MenuInfo default,rgb:12121c
face global Information rgb:deddf4,rgb:201d2f
face global Error rgb:121212,rgb:dedede
face global StatusLine rgb:deddf4,rgb:12121c
face global StatusLineMode rgb:121212,rgb:f6c279
face global StatusLineInfo rgb:ffffff,rgb:12121c
face global StatusLineValue rgb:ffffff,rgb:201d2f
face global StatusCursor default,rgb:787878
face global Prompt rgb:121212,rgb:f6c279
